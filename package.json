{
  "name": "compass-ui",
  "version": "0.2.1",
  "description": "Compass UI - small, dependency-free React primitives for task and planning surfaces.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "import": "./adapters/index.js",
      "default": "./adapters/index.js"
    }
  },
  "files": [
    "dist",
    "adapters",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "compat": "node scripts/check-compat.mjs"
  },
  "keywords": [
    "ui",
    "react",
    "components",
    "design-system",
    "tasks"
  ],
  "license": "MIT"
}
